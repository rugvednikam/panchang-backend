# Environment Variables
PROJECT_NAME="Hindu Astrology REST API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (Asyncpg for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/astrology

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-jwt-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
